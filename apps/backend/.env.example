# ============================================================================
# CRM MAKOR Group Telecom — Configuration d'environnement
# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais committer le fichier .env (voir .gitignore).
# ============================================================================

NODE_ENV=development
PORT=3000

# --- Base de données PostgreSQL ---
# Aligné sur docker-compose.yml (racine du repo, hors backend) : service
# "postgres", port hôte 5433 (mappé sur le 5432 interne du conteneur).
DATABASE_URL="postgresql://makor:makor123@localhost:5433/makor_crm?schema=public"

# --- Authentification JWT ---
# Générer des secrets forts et distincts, ex. : openssl rand -base64 48
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Frontend (liens dans les emails : réinitialisation, etc.) ---
FRONTEND_URL="http://localhost:5173"

# --- Redis (file d'attente BullMQ : envoi de campagnes, exports —
# CDC §2.1, §8.1) ---
# Service "redis" du docker-compose.yml — pas de mot de passe défini côté
# conteneur, laisser REDIS_PASSWORD vide en local.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Email sortant (SMTP) ---
#
# Gmail : MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USER = votre adresse.
#   MAIL_PASSWORD n'est PAS le mot de passe du compte. Avec la double
#   authentification active, Google le refuse (erreur 534). Générez un
#   « mot de passe d'application » de 16 caractères dans les paramètres de
#   sécurité de votre compte Google, et collez-le ici sans les espaces.
#
# MAIL_FROM doit correspondre au compte authentifié, sinon le serveur
#   destinataire rejette le message (erreur 550).
#
# Vérification : POST /api/v1/mail/test (Super Admin) envoie un message d'essai
#   et renvoie l'explication précise en cas d'échec.
# Le port décide du mode de chiffrement : 465 = TLS dès la connexion,
# 587 et 25 = démarrage en clair puis STARTTLS. Renseigner le bon port suffit,
# rien d'autre n'est à régler.
# Laisser MAIL_USER vide pour un serveur local qui n'exige pas d'authentification.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="MAKOR CRM <no-reply@makor.ci>"

# --- Webhook de statut de livraison des campagnes (CDC §2.2) ---
# Secret partagé transmis en en-tête X-Webhook-Secret par la passerelle
# SMS/WhatsApp. Laisser vide désactive la vérification (déconseillé en
# production).
CAMPAIGNS_WEBHOOK_SECRET="change-me"

# --- Seed (prisma/seed.ts) ---
# Mot de passe initial des comptes de démonstration créés par le seed.
# À changer immédiatement après la première connexion en production.
SEED_DEFAULT_PASSWORD="Makor@2026!"

# --- Génération assistée (CDC §4.8, §4.9) ---
# Sans cette clé, l'application fonctionne normalement : seuls les endpoints
# /ai/* renvoient un 503 explicite et le frontend masque les actions de
# génération (voir GET /ai/status).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Double authentification ---
# Échappatoire de recette uniquement : à `false`, l'obligation de configurer
# la 2FA pour Super Admin / Admin ventes / Financier est levée.
# Sans effet dès que NODE_ENV vaut production, où l'obligation s'applique
# toujours quelle que soit la valeur ci-dessous.
TWO_FACTOR_ENFORCED=true

# --- Réception des réponses clients (IMAP) ---
#
# Facultatif : sans IMAP_HOST, la relève est désactivée et le CRM continue de
# fonctionner en envoi seul.
#
# Gmail : IMAP_HOST=imap.gmail.com, IMAP_PORT=993, IMAP_USER = votre adresse,
#   IMAP_PASSWORD = le même mot de passe d'application que pour l'envoi.
#   L'accès IMAP doit être activé dans les paramètres Gmail.
#
# Le CRM relève les messages NON LUS toutes les 5 minutes, les rattache au
# client ou prospect dont l'adresse correspond, verse les pièces jointes dans
# la GED et crée une activité. Un message d'un expéditeur inconnu est ignoré.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
