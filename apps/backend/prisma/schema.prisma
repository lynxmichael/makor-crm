// ============================================================================
// CRM MAKOR Group Telecom — Schéma de données
// Aligné sur le Cahier des Charges v3 (juillet 2026)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. ORGANISATION — Paramètres système, utilisateurs, rôles, permissions
// ============================================================================

/// Paramètres globaux de l'organisation (MAKOR Group Telecom).
/// Enregistrement unique (singleton) — remplace l'ancien modèle "Company"
/// multi-tenant qui n'a pas lieu d'être : le CRM sert une seule organisation.
model OrganizationSettings {
  id String @id @default(cuid())

  companyName String  @default("MAKOR Group Telecom")
  address     String?
  email       String?
  phone       String?
  logoUrl     String?

  /// Taux de TVA par défaut, stocké en fraction (0.18 = 18%)
  vatRate         Decimal @default(0.18) @db.Decimal(5, 4)
  defaultCurrency String  @default("XOF")

  updatedAt DateTime @updatedAt
}

/// Secteurs d'activité — référentiel géré par le Super Admin (CDC §4.5)
model Sector {
  id   String @id @default(cuid())
  name String @unique

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Pays couverts par l'activité commerciale — référentiel (CDC §4.5)
model Country {
  id   String @id @default(cuid())
  name String @unique
  code String @unique // ISO 3166-1 alpha-2, ex. "CI", "BF", "SN"

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Devises supportées (CDC §12 : FCFA de référence, multi-devises)
model Currency {
  id     String @id @default(cuid())
  code   String @unique // ISO 4217, ex. "XOF", "EUR", "USD"
  name   String
  isBase Boolean @default(false)

  /// Taux de conversion vers la devise de base (XOF)
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  users           User[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Regroupement fonctionnel : "clients", "campagnes", "facturation", etc.
model Permission {
  id     String @id @default(cuid())
  code   String @unique
  label  String
  module String @default("general")

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id String @id @default(cuid())

  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
}

/// Équipe / pôle interne — permet au Superviseur de piloter "son équipe"
/// (CDC §1.3 "supervision de l'équipe commerciale")
model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email String  @unique
  phone String? @unique

  password String

  avatar   String?
  jobTitle String?

  isActive Boolean @default(true)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLogin           DateTime?

  // --- Double authentification (2FA — CDC §2.4, §8.2) ---
  twoFactorEnabled      Boolean  @default(false)
  twoFactorSecret       String?
  twoFactorRecoveryCodes String[] @default([])

  roleId       String
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  refreshTokens        RefreshToken[]
  notifications        Notification[]
  assignedLeads         Lead[]
  assignedContacts      Contact[]
  auditLogs             AuditLog[]
  activities            Activity[]
  deals                 Deal[]
  quotes                Quote[]
  purchaseOrdersCreated  PurchaseOrder[]
  contracts              Contract[]
  paymentsCreated       Payment[]
  documents             Document[]        @relation("UploadedDocuments")
  assignedCustomers     Customer[]
  senderIdRequests      SenderIdRequest[] @relation("SenderIdRequestedBy")
  recharges             Recharge[]
  campaignsCreated      Campaign[]        @relation("CampaignCreatedBy")
  objectivesAssigned    Objective[]       @relation("ObjectiveOwner")
  objectivesCreated     Objective[]       @relation("ObjectiveCreatedBy")
  dealStageChanges      DealStageHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([departmentId])
}

/// Session de rafraîchissement JWT — un enregistrement par appareil connecté,
/// ce qui permet la révocation ciblée et la déconnexion multi-appareils.
model RefreshToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String
  userAgent String?
  ipAddress String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================================
// 2. CLIENTS, PROSPECTS, CONTACTS, OPPORTUNITÉS
// ============================================================================

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Client = entreprise avec fiche 360° (CDC §4.2). Un client provient
/// toujours de la conversion d'une Opportunité (Deal) gagnée.
model Customer {
  id String @id @default(cuid())

  code String @unique

  companyName String
  sector      String?
  country     String?
  city        String?
  address     String?

  email   String?
  phone   String? @unique
  website String?

  status CustomerStatus @default(ACTIVE)
  notes  String?

  /// Solde prépayé (FCFA) — alimenté par les rechargements, consommé par
  /// l'envoi de campagnes. Cf. reporting "Soldes prépayés".
  walletBalance Decimal @default(0) @db.Decimal(14, 2)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  contacts       Contact[]
  deals          Deal[]
  documents      Document[]
  activities     Activity[]
  quotes         Quote[]
  purchaseOrders PurchaseOrder[]
  contracts      Contract[]
  invoices       Invoice[]
  payments       Payment[]
  campaigns      Campaign[]
  recharges      Recharge[]
  senderIdRequests SenderIdRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyName])
  @@index([country])
  @@index([status])
}

model Contact {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email String?
  phone String?

  jobTitle  String?
  isPrimary Boolean @default(false)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([assignedToId])
  @@index([email])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  WHATSAPP
  EMAIL
  PHONE
  REFERRAL
  EVENT
  OTHER
}

/// Prospect non encore qualifié en opportunité (CDC §4.3)
model Lead {
  id String @id @default(cuid())

  firstName String
  lastName  String
  company   String?

  email String?
  phone String?

  jobTitle String?
  sector   String?

  /// Décideur identifié chez le prospect (CDC §4.3)
  decisionMaker String?

  value Float?
  notes String?

  source LeadSource @default(OTHER)
  status LeadStatus @default(NEW)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  deals      Deal[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([assignedToId])
}

/// Étape de pipeline configurable (CDC §4.6 : "pipeline personnalisé",
/// "création de pipeline personnalisé par le superadmin"). Remplace
/// l'ancien enum figé qui ne correspondait pas aux étapes du CDC.
model PipelineStage {
  id   String @id @default(cuid())
  name String @unique
  order Int   @unique

  isClosedWon  Boolean @default(false)
  isClosedLost Boolean @default(false)

  /// Si vrai, un deal ne peut entrer dans cette étape que s'il possède un
  /// bon de commande signé (glisser-déposer "conditionné", CDC §4.6).
  requiresSignedOrder Boolean @default(false)

  color String @default("#6366f1")

  deals             Deal[]
  fromStageHistory  DealStageHistory[] @relation("FromStage")
  toStageHistory    DealStageHistory[] @relation("ToStage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Opportunité commerciale (CDC §4.4)
model Deal {
  id String @id @default(cuid())

  title       String
  description String?

  amount      Decimal @db.Decimal(14, 2)
  probability Int     @default(0)

  expectedCloseDate DateTime?

  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  assignedToId String
  assignedTo   User   @relation(fields: [assignedToId], references: [id])

  activities    Activity[]
  quotes        Quote[]
  stageHistory  DealStageHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId])
  @@index([leadId])
  @@index([customerId])
  @@index([assignedToId])
}

/// Traçabilité des changements d'étape (CDC §4.6 "historique")
model DealStageHistory {
  id String @id @default(cuid())

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  fromStageId String?
  fromStage   PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id], onDelete: SetNull)

  toStageId String
  toStage   PipelineStage @relation("ToStage", fields: [toStageId], references: [id], onDelete: Restrict)

  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  note String?

  createdAt DateTime @default(now())

  @@index([dealId])
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
}

enum ActivityStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Rendez-vous / activité commerciale — agenda (CDC §4.12)
model Activity {
  id String @id @default(cuid())

  title       String
  description String?
  location    String?

  type   ActivityType
  status ActivityStatus @default(PLANNED)

  dueDate     DateTime?
  completedAt DateTime?

  /// Compte rendu envoyé automatiquement par email au client (CDC §4.12)
  reportSentAt DateTime?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation(fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([assignedToId])
  @@index([leadId])
  @@index([customerId])
  @@index([dealId])
}

// ============================================================================
// 3. CATALOGUE PRODUITS
// ============================================================================

/// Produit du catalogue MAKOR (CDC §4.5 : SMS Marketing, OTP, API SMS,
/// WhatsApp, Voice, Sender ID)
model Product {
  id String @id @default(cuid())

  name        String
  code        String  @unique
  description String?

  /// Prix catalogue par défaut (peut être affiné par ProductPricing)
  price Float

  isActive Boolean @default(true)

  quoteItems     QuoteItem[]
  invoiceItems   InvoiceItem[]
  purchaseOrderItems PurchaseOrderItem[]
  pricingGrid    ProductPricing[]
  campaigns      Campaign[]
  recharges      Recharge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

/// Grille tarifaire par pays / secteur (CDC §4.5 : "tarif et marge par
/// produit, pays et secteur d'activité")
model ProductPricing {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  country String?
  sector  String?

  unitPrice Decimal @db.Decimal(14, 4)
  unitCost  Decimal @db.Decimal(14, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, country, sector])
}

// ============================================================================
// 4. DEVIS, BONS DE COMMANDE, CONTRATS
// ============================================================================

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

/// Devis (CDC §4.8)
model Quote {
  id String @id @default(cuid())

  number String @unique
  title  String
  notes  String?

  subtotal Decimal @db.Decimal(14, 2)
  tax      Decimal @db.Decimal(14, 2)
  discount Decimal @db.Decimal(14, 2)
  total    Decimal @db.Decimal(14, 2)

  validUntil DateTime?
  status     QuoteStatus @default(DRAFT)
  sentAt     DateTime?

  purchaseOrder PurchaseOrder?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  items QuoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([dealId])
  @@index([status])
}

model QuoteItem {
  id String @id @default(cuid())

  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([quoteId])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  SIGNED
  CANCELLED
}

/// Bon de commande — engagement d'achat formalisé (CDC §4.8, §6).
/// Étape intermédiaire obligatoire entre le Devis accepté et le Contrat.
model PurchaseOrder {
  id String @id @default(cuid())

  number String @unique

  quoteId String? @unique
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  amount        Decimal              @db.Decimal(14, 2)
  paymentMethod String?
  status        PurchaseOrderStatus  @default(DRAFT)

  sentAt   DateTime?
  signedAt DateTime?

  /// Chemin du scan signé (V1 : email + PDF, cf. CDC §5 — la signature
  /// électronique complète est repoussée en V2)
  signedDocumentPath String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  items    PurchaseOrderItem[]
  contract Contract?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model PurchaseOrderItem {
  id String @id @default(cuid())

  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
}

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  TERMINATED
  EXPIRED
}

/// Contrat formalisé (CDC §4.9)
model Contract {
  id String @id @default(cuid())

  number      String  @unique
  title       String
  description String?

  amount Decimal @db.Decimal(14, 2)

  startDate DateTime
  endDate   DateTime?
  signedAt  DateTime?

  status ContractStatus @default(DRAFT)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  purchaseOrderId String?        @unique
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

// ============================================================================
// 5. FACTURATION & ENCAISSEMENTS
// ============================================================================

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

model Invoice {
  id String @id @default(cuid())

  number String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  subtotal Decimal @db.Decimal(14, 2)
  discount Decimal @default(0) @db.Decimal(14, 2)
  tax      Decimal @default(0) @db.Decimal(14, 2)
  total    Decimal @db.Decimal(14, 2)

  status InvoiceStatus @default(DRAFT)

  issuedAt DateTime  @default(now())
  dueDate  DateTime?

  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model InvoiceItem {
  id String @id @default(cuid())

  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_MONEY
  WAVE
  ORANGE_MONEY
  MTN_MOMO
  MOOV_MONEY
  CINETPAY
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

/// Encaissement (CDC §4.10 : "enregistrement des règlements reçus et
/// rapprochement avec les factures")
model Payment {
  id String @id @default(cuid())

  reference     String  @unique
  transactionId String?

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("XOF")

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  provider         String?
  providerResponse Json?

  paidAt DateTime?

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
  @@index([method])
}

/// Rechargement / crédit prépayé client (cf. reporting "Réchargements",
/// "Soldes prépayés")
model Recharge {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  amount Decimal  @db.Decimal(14, 2)
  date   DateTime @default(now())

  recordedById String?
  recordedBy   User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([date])
}

// ============================================================================
// 6. SENDER ID (CDC §4.11)
// ============================================================================

enum SenderIdStatus {
  PENDING
  APPROVED
  REJECTED
}

model SenderIdRequest {
  id String @id @default(cuid())

  name    String
  partner String?

  status SenderIdStatus @default(PENDING)
  notes  String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("SenderIdRequestedBy", fields: [requestedById], references: [id])

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

// ============================================================================
// 7. CAMPAGNES (CDC §2.2, §4.7)
// ============================================================================

enum CampaignType {
  EMAIL
  SMS
  WHATSAPP
  VOICE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  RUNNING
  FINISHED
  FAILED
  CANCELLED
}

model Campaign {
  id String @id @default(cuid())

  name    String
  subject String?
  message String

  type   CampaignType
  status CampaignStatus @default(DRAFT)

  country String?

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?

  /// Alerte déclenchée en cas d'anomalie (pic d'échecs, volume anormal...)
  anomalyDetectedAt DateTime?
  anomalyReason     String?

  createdById String?
  createdBy   User?   @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  recipients CampaignRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  REJECTED
}

/// Destinataire individuel d'une campagne — permet le calcul du taux de
/// délivrabilité et le suivi des rejets (CDC §2.2, §9)
model CampaignRecipient {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  destination String // numéro ou email du destinataire

  status CampaignRecipientStatus @default(PENDING)

  /// Code erreur remonté par la passerelle (cf. reporting "Rejets SMS")
  errorCode String?

  cost Decimal? @db.Decimal(14, 4)

  sentAt      DateTime?
  deliveredAt DateTime?

  /// Référence du message côté passerelle (utile pour le webhook de statut)
  providerMessageId String?

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([status])
  @@index([providerMessageId])
}

// ============================================================================
// 8. GED — DOCUMENTS (CDC §4.13)
// ============================================================================

enum DocumentType {
  CONTRACT
  INVOICE
  QUOTE
  PURCHASE_ORDER
  IMAGE
  PDF
  WORD
  EXCEL
  OTHER
}

model Document {
  id String @id @default(cuid())

  name     String
  fileName String
  path     String
  mimeType String
  size     Int

  type DocumentType @default(OTHER)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  uploadedById String
  uploadedBy   User   @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([uploadedById])
  @@index([dealId])
  @@index([quoteId])
  @@index([contractId])
}

// ============================================================================
// 9. OBJECTIFS COMMERCIAUX (CDC §4.1, §9)
// ============================================================================

model Objective {
  id String @id @default(cuid())

  userId String
  user   User   @relation("ObjectiveOwner", fields: [userId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  targetAmount Decimal @db.Decimal(14, 2)
  targetDeals  Int?

  createdById String
  createdBy   User   @relation("ObjectiveCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([periodStart, periodEnd])
}

// ============================================================================
// 10. NOTIFICATIONS (CDC §4.14) & AUDIT (CDC §4.16)
// ============================================================================

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

model Notification {
  id String @id @default(cuid())

  title   String
  message String

  type    NotificationType    @default(INFO)
  channel NotificationChannel @default(IN_APP)

  isRead Boolean @default(false)
  sentAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  EXPORT
}

model AuditLog {
  id String @id @default(cuid())

  action AuditAction

  entity      String
  entityId    String?
  description String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([action])
}
