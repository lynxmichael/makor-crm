generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrganizationSettings {
  id String @id @default(cuid())

  companyName String  @default("MAKOR Group Telecom")
  address     String?
  email       String?
  phone       String?
  logoUrl     String?

  vatRate         Decimal @default(0.18) @db.Decimal(5, 4)
  defaultCurrency String  @default("XOF")

  updatedAt DateTime @updatedAt
}

model Sector {
  id   String @id @default(cuid())
  name String @unique

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Country {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Currency {
  id     String  @id @default(cuid())
  code   String  @unique // ISO 4217, ex. "XOF", "EUR", "USD"
  name   String
  isBase Boolean @default(false)

  exchangeRate Decimal @default(1) @db.Decimal(18, 6)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Role {
  id String @id @default(cuid())

  /// Identifiant technique, en majuscules. Sert de discriminant dans @Roles()
  /// et dans les gardes : ne jamais le traduire ni le renommer à la légère.
  name String @unique

  /// Libellé affiché dans l'interface. Modifiable dans Paramètres sans
  /// toucher au code : c'est ce qui permet d'appeler « Financier » le rôle
  /// techniquement nommé MANAGER.
  label String?

  description String?

  users           User[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  commissionPlans CommissionPlan[]
}

model Permission {
  id     String @id @default(cuid())
  code   String @unique
  label  String
  module String @default("general")

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id String @id @default(cuid())

  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
}

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email String  @unique
  phone String? @unique

  password String

  avatar   String?
  jobTitle String?

  isActive Boolean @default(true)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLogin           DateTime?

  twoFactorEnabled       Boolean  @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[] @default([])

  companyId String?

  company      Company?    @relation(fields: [companyId], references: [id])
  roleId       String
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  refreshTokens         RefreshToken[]
  notifications         Notification[]
  assignedLeads         Lead[]
  assignedContacts      Contact[]
  auditLogs             AuditLog[]
  activities            Activity[]
  deals                 Deal[]
  quotes                Quote[]
  purchaseOrdersCreated PurchaseOrder[]
  contracts             Contract[]
  paymentsCreated       Payment[]
  documents             Document[]         @relation("UploadedDocuments")
  assignedCustomers     Customer[]
  senderIdRequests      SenderIdRequest[]  @relation("SenderIdRequestedBy")
  recharges             Recharge[]
  campaignsCreated      Campaign[]         @relation("CampaignCreatedBy")
  objectivesAssigned    Objective[]        @relation("ObjectiveOwner")
  objectivesCreated     Objective[]        @relation("ObjectiveCreatedBy")
  dealStageChanges      DealStageHistory[]

  comments          Comment[]      @relation("CommentAuthor")
  messagesSent      Message[]      @relation("MessageSender")
  messagesReceived  Message[]      @relation("MessageRecipient")
  aiGenerations     AiGeneration[] @relation("AiRequestedBy")
  resources         Resource[]     @relation("ResourceAuthor")
  apiKeys           ApiKey[]       @relation("ApiKeyCreatedBy")
  signatureRequests SignatureRequest[] @relation("SignatureRequestedBy")
  workflows         Workflow[]         @relation("WorkflowCreatedBy")
  commissions       Commission[]       @relation("CommissionBeneficiary")
  commissionPlans   CommissionPlan[]   @relation("CommissionPlanUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@index([roleId])
  @@index([departmentId])
}

model RefreshToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String
  userAgent String?
  ipAddress String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Customer {
  id String @id @default(cuid())

  code String @unique

  companyName String
  sector      String?
  country     String?
  city        String?
  address     String?

  email   String?
  phone   String? @unique
  website String?

  status    CustomerStatus @default(ACTIVE)
  notes     String?
  companyId String?

  company Company? @relation(fields: [companyId], references: [id])

  walletBalance Decimal @default(0) @db.Decimal(14, 2)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  contacts         Contact[]
  deals            Deal[]
  documents        Document[]
  activities       Activity[]
  quotes           Quote[]
  purchaseOrders   PurchaseOrder[]
  contracts        Contract[]
  invoices         Invoice[]
  payments         Payment[]
  campaigns        Campaign[]
  recharges        Recharge[]
  senderIdRequests SenderIdRequest[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  tickets       Ticket[]

  @@index([companyName])
  @@index([country])
  @@index([status])
  apiKeys ApiKey[]
}

model Contact {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email String?
  phone String?

  jobTitle  String?
  isPrimary Boolean @default(false)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([assignedToId])
  @@index([email])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  WHATSAPP
  EMAIL
  PHONE
  REFERRAL
  EVENT
  OTHER
}

model Lead {
  id String @id @default(cuid())

  firstName String
  lastName  String
  company   String?

  email String?
  phone String?

  jobTitle String?
  sector   String?

  decisionMaker String?

  value Float?
  notes String?

  source LeadSource @default(OTHER)
  status LeadStatus @default(NEW)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  deals      Deal[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([assignedToId])
}

model PipelineStage {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @unique

  isClosedWon  Boolean @default(false)
  isClosedLost Boolean @default(false)

  requiresSignedOrder Boolean @default(false)

  color String @default("#6366f1")

  deals            Deal[]
  fromStageHistory DealStageHistory[] @relation("FromStage")
  toStageHistory   DealStageHistory[] @relation("ToStage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Deal {
  id String @id @default(cuid())

  title       String
  description String?

  amount      Decimal @db.Decimal(14, 2)
  probability Int     @default(0)

  /// Réponses à la grille de qualification (CDC §4.6), une clé par question
  /// sous la forme `<etape>.<champ>`. Stockée en JSON plutôt qu'en colonnes :
  /// les questions évoluent avec la méthode commerciale, et chaque évolution
  /// exigerait sinon une migration.
  qualification Json?

  /// Points de contrôle de mise en service, cochés à l'étape Go live.
  goLiveChecklist Json?

  expectedCloseDate DateTime?

  stageId   String
  documents Document[]
  stage     PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  assignedToId String
  assignedTo   User   @relation(fields: [assignedToId], references: [id])

  activities   Activity[]
  quotes       Quote[]
  stageHistory DealStageHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId])
  @@index([leadId])
  @@index([customerId])
  @@index([assignedToId])
}

model DealStageHistory {
  id String @id @default(cuid())

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  fromStageId String?
  fromStage   PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id], onDelete: SetNull)

  toStageId String
  toStage   PipelineStage @relation("ToStage", fields: [toStageId], references: [id], onDelete: Restrict)

  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  note String?

  createdAt DateTime @default(now())

  @@index([dealId])
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
}

enum ActivityStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Activity {
  id String @id @default(cuid())

  title       String
  description String?
  location    String?

  type   ActivityType
  status ActivityStatus @default(PLANNED)

  dueDate     DateTime?
  completedAt DateTime?

  reportSentAt DateTime?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation(fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([assignedToId])
  @@index([leadId])
  @@index([customerId])
  @@index([dealId])
}

model Product {
  id String @id @default(cuid())

  name        String
  code        String  @unique
  description String?

  price Float

  isActive Boolean @default(true)

  quoteItems         QuoteItem[]
  invoiceItems       InvoiceItem[]
  purchaseOrderItems PurchaseOrderItem[]
  pricingGrid        ProductPricing[]
  campaigns          Campaign[]
  recharges          Recharge[]
  offers             Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model ProductPricing {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  country String?
  sector  String?

  unitPrice Decimal @db.Decimal(14, 4)
  unitCost  Decimal @db.Decimal(14, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, country, sector])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id String @id @default(cuid())

  number String  @unique
  title  String
  notes  String?

  subtotal Decimal @db.Decimal(14, 2)
  tax      Decimal @db.Decimal(14, 2)
  discount Decimal @db.Decimal(14, 2)
  total    Decimal @db.Decimal(14, 2)

  validUntil DateTime?
  status     QuoteStatus @default(DRAFT)
  sentAt     DateTime?

  purchaseOrder PurchaseOrder?

  customerId String
  documents  Document[]
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  items QuoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([dealId])
  @@index([status])
}

model QuoteItem {
  id String @id @default(cuid())

  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([quoteId])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  SIGNED
  CANCELLED
}

model PurchaseOrder {
  id String @id @default(cuid())

  number String @unique

  quoteId String? @unique
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  amount        Decimal             @db.Decimal(14, 2)
  paymentMethod String?
  status        PurchaseOrderStatus @default(DRAFT)

  sentAt   DateTime?
  signedAt DateTime?

  signedDocumentPath String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  items    PurchaseOrderItem[]
  contract Contract?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model PurchaseOrderItem {
  id String @id @default(cuid())

  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
}

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  TERMINATED
  EXPIRED
}

model Contract {
  id String @id @default(cuid())

  number      String  @unique
  title       String
  description String?

  amount Decimal @db.Decimal(14, 2)

  startDate DateTime
  endDate   DateTime?
  signedAt  DateTime?
  documents Document[]

  status ContractStatus @default(DRAFT)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  purchaseOrderId String?        @unique
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

model Invoice {
  id String @id @default(cuid())

  number String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  subtotal Decimal @db.Decimal(14, 2)
  discount Decimal @default(0) @db.Decimal(14, 2)
  tax      Decimal @default(0) @db.Decimal(14, 2)
  total    Decimal @db.Decimal(14, 2)

  status InvoiceStatus @default(DRAFT)

  issuedAt DateTime  @default(now())
  dueDate  DateTime?

  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model InvoiceItem {
  id String @id @default(cuid())

  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_MONEY
  WAVE
  ORANGE_MONEY
  MTN_MOMO
  MOOV_MONEY
  CINETPAY
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

model Payment {
  id String @id @default(cuid())

  reference     String  @unique
  transactionId String?

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("XOF")

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  provider         String?
  providerResponse Json?

  paidAt DateTime?

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
  @@index([method])
}

model Recharge {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  amount Decimal  @db.Decimal(14, 2)
  date   DateTime @default(now())

  recordedById String?
  recordedBy   User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([date])
}

enum SenderIdStatus {
  PENDING
  APPROVED
  REJECTED
}

model SenderIdRequest {
  id String @id @default(cuid())

  name    String
  partner String?

  status SenderIdStatus @default(PENDING)
  notes  String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("SenderIdRequestedBy", fields: [requestedById], references: [id])

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

enum CampaignType {
  EMAIL
  SMS
  WHATSAPP
  VOICE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  RUNNING
  FINISHED
  FAILED
  CANCELLED
}

model Campaign {
  id String @id @default(cuid())

  name    String
  subject String?
  message String

  type   CampaignType
  status CampaignStatus @default(DRAFT)

  country String?

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?

  anomalyDetectedAt DateTime?
  anomalyReason     String?

  createdById String?
  createdBy   User?   @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  recipients CampaignRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  REJECTED
}

model CampaignRecipient {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  destination String

  status CampaignRecipientStatus @default(PENDING)

  errorCode String?

  cost Decimal? @db.Decimal(14, 4)

  sentAt      DateTime?
  deliveredAt DateTime?

  providerMessageId String?

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([status])
  @@index([providerMessageId])
}

enum DocumentType {
  CONTRACT
  INVOICE
  QUOTE
  PURCHASE_ORDER
  IMAGE
  PDF
  WORD
  EXCEL
  OTHER
}

model Document {
  id String @id @default(cuid())

  name     String
  fileName String
  path     String
  mimeType String
  size     Int

  type DocumentType @default(OTHER)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  uploadedById String
  uploadedBy   User   @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([uploadedById])
  @@index([dealId])
  @@index([quoteId])
  @@index([contractId])
}

model Objective {
  id String @id @default(cuid())

  userId String
  user   User   @relation("ObjectiveOwner", fields: [userId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  targetAmount Decimal @db.Decimal(14, 2)
  targetDeals  Int?

  createdById String
  createdBy   User   @relation("ObjectiveCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([periodStart, periodEnd])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

model Notification {
  id String @id @default(cuid())

  title   String
  message String

  type    NotificationType    @default(INFO)
  channel NotificationChannel @default(IN_APP)

  isRead Boolean   @default(false)
  sentAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  EXPORT
}

model AuditLog {
  id String @id @default(cuid())

  action AuditAction

  entity      String
  entityId    String?
  description String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([action])
}

model Company {
  id String @id @default(cuid())

  name String @unique
  code String @unique

  email   String?
  phone   String?
  website String?

  address String?
  city    String?
  country String?

  taxNumber String?
  users     User[]
  customers Customer[]
  offers    Offer[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OfferStatus {
  DRAFT
  ACTIVE
  EXPIRED
  DISABLED
}

model Offer {
  id String @id @default(cuid())

  name String
  code String @unique

  description String?

  price Decimal @db.Decimal(14, 2)

  duration Int?

  status OfferStatus @default(DRAFT)

  isActive Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([productId])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

model Subscription {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Restrict)

  startDate DateTime
  endDate   DateTime?

  amount Decimal @db.Decimal(14, 2)

  status SubscriptionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([offerId])
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id String @id @default(cuid())

  reference String @unique

  subject     String
  description String?

  priority TicketPriority @default(MEDIUM)

  status TicketStatus @default(OPEN)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([assignedToId])
  @@index([status])
}

model Warehouse {
  id String @id @default(cuid())

  code String @unique
  name String

  address String?
  city    String?
  country String?

  manager String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===========================================================================
// Commentaires (CDC §4.1) — « possibilité de laisser des commentaires »
// ===========================================================================

/**
 * Entités commentables. Le commentaire est polymorphe : une seule table
 * plutôt qu'une table de commentaires par module, sinon la fonctionnalité
 * devrait être réimplémentée à chaque nouvel écran.
 *
 * DASHBOARD est une portée libre, sans entityId : c'est le fil de commentaires
 * du tableau de bord, que le CDC réserve au profil Admin ventes.
 */
enum CommentEntity {
  DASHBOARD
  CUSTOMER
  LEAD
  DEAL
  QUOTE
  PURCHASE_ORDER
  CONTRACT
  INVOICE
  CAMPAIGN
}

model Comment {
  id String @id @default(cuid())

  body String

  entityType CommentEntity
  /// Nul pour les portées globales (DASHBOARD).
  entityId   String?

  /// Réponse à un autre commentaire — un seul niveau d'imbrication.
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  /// Utilisateurs mentionnés (@) — sert à déclencher une notification.
  mentionedUserIds String[] @default([])

  authorId String
  author   User   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// Renseigné dès la première modification : l'interface affiche « modifié ».
  editedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([authorId])
  @@index([parentId])
}

// ===========================================================================
// Messagerie interne (CDC §4.1)
// « envoie et reçois de message et des documents entre eux par email »
// ===========================================================================

model Message {
  id String @id @default(cuid())

  subject String?
  body    String

  /// Pièce jointe unique, stockée sous /uploads comme la GED.
  attachmentPath String?
  attachmentName String?
  attachmentSize Int?

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User   @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  readAt DateTime?

  /// Suppression par corbeille, côté expéditeur et destinataire séparément :
  /// chacun range sa boîte sans effacer le message de l'autre.
  deletedBySender    Boolean @default(false)
  deletedByRecipient Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([recipientId, readAt])
  @@index([senderId])
  @@index([createdAt])
}

// ===========================================================================
// Génération assistée (CDC §4.8, §4.9 — tags « (ia) » / « (claudeia) »)
// ===========================================================================

enum AiTaskType {
  QUOTE_INTRO
  QUOTE_TERMS
  CONTRACT_BODY
  CONTRACT_CLAUSE
  EMAIL_DRAFT
  MEETING_SUMMARY
}

/**
 * Trace des générations. Trois raisons de la garder :
 * l'audit (CDC §4.16), la possibilité de revenir à une version précédente,
 * et le suivi du coût en jetons.
 *
 * Le texte généré n'est jamais appliqué automatiquement : il est proposé,
 * puis accepté ou rejeté par un humain — d'où `acceptedAt`.
 */
model AiGeneration {
  id String @id @default(cuid())

  taskType AiTaskType

  /// Entité concernée (devis, contrat…), pour retrouver l'historique.
  entityType CommentEntity?
  entityId   String?

  /// Consigne de l'utilisateur, hors contexte injecté automatiquement.
  instruction String?

  output String

  model       String
  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  acceptedAt DateTime?

  requestedById String
  requestedBy   User   @relation("AiRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([requestedById])
}

// ===========================================================================
// Espace Ressources — formation et documentation (demande du 31/07/2026)
// ===========================================================================

/**
 * Module du CRM auquel se rattache une ressource. Permet de grouper la
 * formation par écran plutôt que par ordre d'ajout : un commercial qui bute
 * sur les devis cherche « Devis », pas la ressource n° 14.
 */
enum ResourceCategory {
  GENERAL
  PRISE_EN_MAIN
  CLIENTS
  PIPELINE
  CAMPAGNES
  DEVIS_COMMANDES
  CONTRATS
  FACTURATION
  SENDER_ID
  AGENDA
  DOCUMENTS
  REPORTING
  PARAMETRES
}

enum ResourceType {
  DOCUMENT
  VIDEO
  LIEN
  ARTICLE
}

model Resource {
  id String @id @default(cuid())

  title       String
  description String?

  category ResourceCategory @default(GENERAL)
  type     ResourceType     @default(DOCUMENT)

  /// Fichier déposé — pour type DOCUMENT.
  filePath String?
  fileName String?
  fileSize Int?

  /// Lien externe — pour type VIDEO ou LIEN.
  url String?

  /// Contenu rédigé directement dans le CRM — pour type ARTICLE.
  content String?

  /// Ordre d'affichage au sein de la catégorie.
  position Int @default(0)

  /// Un brouillon reste invisible des agents tant qu'il n'est pas publié.
  isPublished Boolean @default(true)

  /// Compteur de consultations, pour repérer ce qui sert et ce qui dort.
  viewCount Int @default(0)

  createdById String
  createdBy   User   @relation("ResourceAuthor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, position])
  @@index([isPublished])
  @@index([createdById])
}

// ===========================================================================
// API partenaires (CDC §5 — V2)
// ===========================================================================

/**
 * Périmètre accordé à une clé. Une clé d'intégration ne doit jamais tout
 * pouvoir : un partenaire qui n'envoie que des OTP n'a aucune raison de
 * pouvoir lire le solde d'un autre client.
 */
enum ApiScope {
  MESSAGES_SEND
  MESSAGES_READ
  BALANCE_READ
  CAMPAIGNS_READ
}

model ApiKey {
  id String @id @default(cuid())

  /// Nom donné par l'administrateur — « Intégration boutique en ligne ».
  name String

  /// Préfixe visible (mk_live_a1b2c3). Sert à identifier la clé sans la
  /// révéler, et à retrouver la ligne sans comparer tous les hachages.
  prefix String @unique

  /// Seul le haché est conservé. La clé complète n'est affichée qu'une fois,
  /// à la création : nous ne pouvons pas la retrouver, seulement la révoquer.
  keyHash String

  scopes ApiScope[] @default([])

  /// Le partenaire agit pour le compte de ce client : ses envois sont
  /// débités de son solde et apparaissent dans son reporting.
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Sender ID imposé aux envois de cette clé, quand il est fixé.
  senderId String?

  /// Plafond d'appels par minute. Zéro = pas de limite propre à la clé.
  rateLimitPerMinute Int @default(60)

  isActive  Boolean   @default(true)
  expiresAt DateTime?

  lastUsedAt DateTime?
  usageCount Int       @default(0)

  /// Renseigné à la révocation — on ne supprime pas une clé, on la coupe :
  /// les envois passés doivent rester rattachables à leur origine.
  revokedAt DateTime?

  createdById String?
  createdBy   User?   @relation("ApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  requests ApiRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([isActive])
}

/**
 * Journal des appels partenaires. Distinct de l'AuditLog, qui trace les
 * actions humaines : ici le volume est d'un autre ordre, et les besoins
 * diffèrent — facturation, diagnostic d'intégration, détection d'abus.
 */
model ApiRequest {
  id String @id @default(cuid())

  apiKeyId String
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  method   String
  path     String
  status   Int
  /// Durée de traitement en millisecondes.
  durationMs Int @default(0)

  ipAddress String?
  errorCode String?

  createdAt DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@index([createdAt])
}

// ===========================================================================
// Signature électronique (CDC §5 — V2)
// ===========================================================================

enum SignableEntity {
  QUOTE
  PURCHASE_ORDER
  CONTRACT
}

enum SignatureStatus {
  PENDING
  VIEWED
  SIGNED
  REFUSED
  EXPIRED
  CANCELLED
}

/**
 * Demande de signature envoyée à un client.
 *
 * L'implémentation native produit une « signature électronique simple » :
 * le signataire trace ou saisit sa signature, et l'on conserve les éléments
 * qui la rendent opposable — horodatage, adresse IP, navigateur, et
 * empreinte SHA-256 du document au moment de la signature. Cette empreinte
 * est le point clé : elle prouve que le document n'a pas changé après coup.
 *
 * Le passage à un prestataire qualifié (signature avancée ou qualifiée) se
 * fait en fournissant une autre implémentation à SIGNATURE_PROVIDER, sans
 * toucher au reste — même principe que la passerelle SMS (CDC §2.2).
 */
model SignatureRequest {
  id String @id @default(cuid())

  entityType SignableEntity
  entityId   String

  signerName  String
  signerEmail String
  /// Facultatif — permet une relance par SMS ou WhatsApp.
  signerPhone String?

  /// Jeton d'accès au lien public de signature. Long et aléatoire : c'est
  /// la seule barrière avant la page de signature, qui n'est pas
  /// authentifiée — un client n'a pas de compte sur le CRM.
  token String @unique

  status SignatureStatus @default(PENDING)

  /// Empreinte SHA-256 du PDF présenté, figée à l'envoi.
  documentHash String

  /// Trace de la signature : image tracée en base64, ou nom saisi.
  signatureData String?
  signatureType String?

  /// Éléments de preuve collectés au moment de la signature.
  signedAt   DateTime?
  signedIp   String?
  signedUserAgent String?

  viewedAt   DateTime?
  refusedAt  DateTime?
  refusalReason String?

  expiresAt DateTime

  /// Renseigné quand un prestataire externe est utilisé.
  providerName      String?
  providerRequestId String?

  requestedById String?
  requestedBy   User?   @relation("SignatureRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([status])
}

// ===========================================================================
// Commissions (CDC §5 — V2)
// ===========================================================================

/** Assiette de calcul de la commission. */
enum CommissionBase {
  /// Montant signé, hors taxes.
  SIGNED_AMOUNT
  /// Marge réalisée — nécessite un coût de revient renseigné sur les produits.
  MARGIN
  /// Montant réellement encaissé.
  COLLECTED_AMOUNT
}

/** Fait générateur : à quel moment la commission naît. */
enum CommissionTrigger {
  PURCHASE_ORDER_SIGNED
  CONTRACT_ACTIVATED
  INVOICE_PAID
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

/**
 * Barème de commissionnement.
 *
 * Les règles sont en base et non dans le code : un taux de commission se
 * renégocie, et cela ne doit pas demander un redéploiement. Un barème peut
 * viser un rôle entier ou un commercial précis — le second l'emporte.
 */
model CommissionPlan {
  id String @id @default(cuid())

  name String

  /// Taux appliqué à l'assiette. 0.05 = 5 %.
  rate Decimal @db.Decimal(6, 4)

  base    CommissionBase    @default(SIGNED_AMOUNT)
  trigger CommissionTrigger @default(INVOICE_PAID)

  /// Plancher en deçà duquel aucune commission n'est due.
  minimumAmount Decimal? @db.Decimal(14, 2)
  /// Plafond par opération, quand il en existe un.
  capAmount     Decimal? @db.Decimal(14, 2)

  /// Barème applicable à tout un rôle.
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  /// Barème nominatif — prime sur le barème de rôle.
  userId String?
  user   User?   @relation("CommissionPlanUser", fields: [userId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  commissions Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([userId])
}

/**
 * Commission acquise sur une opération.
 *
 * Le taux et l'assiette sont recopiés à la création plutôt que lus depuis le
 * barème : une renégociation ne doit pas réécrire l'historique des
 * commissions déjà acquises.
 */
model Commission {
  id String @id @default(cuid())

  userId String
  user   User   @relation("CommissionBeneficiary", fields: [userId], references: [id], onDelete: Cascade)

  planId String?
  plan   CommissionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  /// Opération d'origine — facture, bon de commande ou contrat.
  sourceType String
  sourceId   String

  baseAmount Decimal @db.Decimal(14, 2)
  rate       Decimal @db.Decimal(6, 4)
  amount     Decimal @db.Decimal(14, 2)

  /// Période de rattachement, au format AAAA-MM.
  period String

  status CommissionStatus @default(PENDING)

  approvedAt DateTime?
  paidAt     DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceType, sourceId, userId])
  @@index([userId, period])
  @@index([status])
}

// ===========================================================================
// Moteur de workflow (CDC §5 — V2)
// ===========================================================================

/**
 * Fait déclencheur d'une règle.
 *
 * Volontairement fermé plutôt que libre : chaque valeur correspond à un
 * point d'accroche réellement instrumenté dans le code métier. Une liste
 * ouverte laisserait créer des règles qui ne se déclencheraient jamais,
 * sans que rien ne le signale.
 */
enum WorkflowTrigger {
  DEAL_STAGE_CHANGED
  DEAL_CREATED
  QUOTE_SENT
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  PURCHASE_ORDER_SIGNED
  CONTRACT_ACTIVATED
  INVOICE_SENT
  INVOICE_PAID
  INVOICE_OVERDUE
  CUSTOMER_CREATED
  LEAD_CREATED
  ACTIVITY_OVERDUE
  CAMPAIGN_FINISHED
  SIGNATURE_SIGNED
  SIGNATURE_REFUSED
}

enum WorkflowActionType {
  NOTIFY_USER
  NOTIFY_ROLE
  SEND_EMAIL
  CREATE_ACTIVITY
  ASSIGN_OWNER
  UPDATE_FIELD
  POST_COMMENT
  CALL_WEBHOOK
}

enum WorkflowRunStatus {
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

model Workflow {
  id String @id @default(cuid())

  name        String
  description String?

  trigger WorkflowTrigger

  /**
   * Conditions à remplir, au format JSON :
   * `[{ "field": "amount", "operator": "gte", "value": 1000000 }]`
   *
   * Toutes doivent être vraies. Un tableau vide signifie « toujours ».
   * Ne pas modéliser les conditions en tables évite une jointure par
   * critère, au prix d'une validation applicative — arbitrage assumé pour
   * un volume de règles qui restera modeste.
   */
  conditions Json @default("[]")

  /// Délai avant exécution, en minutes. Zéro = immédiat.
  delayMinutes Int @default(0)

  isActive Boolean @default(true)

  /// Empêche une règle emballée de saturer les notifications.
  maxRunsPerDay Int @default(500)

  actions WorkflowAction[]
  runs    WorkflowRun[]

  createdById String?
  createdBy   User?   @relation("WorkflowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trigger, isActive])
}

model WorkflowAction {
  id String @id @default(cuid())

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  type WorkflowActionType

  /**
   * Paramètres propres au type d'action — destinataire, gabarit, champ à
   * modifier. Leur forme dépend du type, d'où le JSON plutôt qu'une
   * colonne par variante.
   */
  config Json @default("{}")

  /// Ordre d'exécution au sein de la règle.
  position Int @default(0)

  createdAt DateTime @default(now())

  @@index([workflowId, position])
}

/**
 * Journal d'exécution. Sans lui, une règle qui ne se déclenche pas est
 * indébogable : on ne sait pas distinguer « jamais déclenchée » de
 * « déclenchée mais condition fausse » ou « action en échec ».
 */
model WorkflowRun {
  id String @id @default(cuid())

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  /// Entité ayant déclenché la règle.
  entityType String
  entityId   String

  status WorkflowRunStatus

  /// Détail par action : ce qui a réussi, ce qui a échoué et pourquoi.
  result Json @default("{}")

  /// Renseigné quand les conditions n'étaient pas remplies.
  skipReason String?

  durationMs Int @default(0)

  createdAt DateTime @default(now())

  @@index([workflowId, createdAt])
  @@index([entityType, entityId])
}
