generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrganizationSettings {
  id String @id @default(cuid())

  companyName String  @default("MAKOR Group Telecom")
  address     String?
  email       String?
  phone       String?
  logoUrl     String?

  vatRate         Decimal @default(0.18) @db.Decimal(5, 4)
  defaultCurrency String  @default("XOF")

  updatedAt DateTime @updatedAt
}

model Sector {
  id   String @id @default(cuid())
  name String @unique

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Country {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Currency {
  id     String  @id @default(cuid())
  code   String  @unique // ISO 4217, ex. "XOF", "EUR", "USD"
  name   String
  isBase Boolean @default(false)

  exchangeRate Decimal @default(1) @db.Decimal(18, 6)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  users           User[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id     String @id @default(cuid())
  code   String @unique
  label  String
  module String @default("general")

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id String @id @default(cuid())

  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
}

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email String  @unique
  phone String? @unique

  password String

  avatar   String?
  jobTitle String?

  isActive Boolean @default(true)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLogin           DateTime?

  twoFactorEnabled       Boolean  @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[] @default([])

  companyId String?

  company      Company?    @relation(fields: [companyId], references: [id])
  roleId       String
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  refreshTokens         RefreshToken[]
  notifications         Notification[]
  assignedLeads         Lead[]
  assignedContacts      Contact[]
  auditLogs             AuditLog[]
  activities            Activity[]
  deals                 Deal[]
  quotes                Quote[]
  purchaseOrdersCreated PurchaseOrder[]
  contracts             Contract[]
  paymentsCreated       Payment[]
  documents             Document[]         @relation("UploadedDocuments")
  assignedCustomers     Customer[]
  senderIdRequests      SenderIdRequest[]  @relation("SenderIdRequestedBy")
  recharges             Recharge[]
  campaignsCreated      Campaign[]         @relation("CampaignCreatedBy")
  objectivesAssigned    Objective[]        @relation("ObjectiveOwner")
  objectivesCreated     Objective[]        @relation("ObjectiveCreatedBy")
  dealStageChanges      DealStageHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@index([roleId])
  @@index([departmentId])
}

model RefreshToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String
  userAgent String?
  ipAddress String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Customer {
  id String @id @default(cuid())

  code String @unique

  companyName String
  sector      String?
  country     String?
  city        String?
  address     String?

  email   String?
  phone   String? @unique
  website String?

  status    CustomerStatus @default(ACTIVE)
  notes     String?
  companyId String?

  company Company? @relation(fields: [companyId], references: [id])

  walletBalance Decimal @default(0) @db.Decimal(14, 2)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  contacts         Contact[]
  deals            Deal[]
  documents        Document[]
  activities       Activity[]
  quotes           Quote[]
  purchaseOrders   PurchaseOrder[]
  contracts        Contract[]
  invoices         Invoice[]
  payments         Payment[]
  campaigns        Campaign[]
  recharges        Recharge[]
  senderIdRequests SenderIdRequest[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  tickets       Ticket[]

  @@index([companyName])
  @@index([country])
  @@index([status])
}

model Contact {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email String?
  phone String?

  jobTitle  String?
  isPrimary Boolean @default(false)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([assignedToId])
  @@index([email])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  WHATSAPP
  EMAIL
  PHONE
  REFERRAL
  EVENT
  OTHER
}

model Lead {
  id String @id @default(cuid())

  firstName String
  lastName  String
  company   String?

  email String?
  phone String?

  jobTitle String?
  sector   String?

  decisionMaker String?

  value Float?
  notes String?

  source LeadSource @default(OTHER)
  status LeadStatus @default(NEW)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  deals      Deal[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([assignedToId])
}

model PipelineStage {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @unique

  isClosedWon  Boolean @default(false)
  isClosedLost Boolean @default(false)

  requiresSignedOrder Boolean @default(false)

  color String @default("#6366f1")

  deals            Deal[]
  fromStageHistory DealStageHistory[] @relation("FromStage")
  toStageHistory   DealStageHistory[] @relation("ToStage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Deal {
  id String @id @default(cuid())

  title       String
  description String?

  amount      Decimal @db.Decimal(14, 2)
  probability Int     @default(0)

  expectedCloseDate DateTime?

  stageId   String
  documents Document[]
  stage     PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  assignedToId String
  assignedTo   User   @relation(fields: [assignedToId], references: [id])

  activities   Activity[]
  quotes       Quote[]
  stageHistory DealStageHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId])
  @@index([leadId])
  @@index([customerId])
  @@index([assignedToId])
}

model DealStageHistory {
  id String @id @default(cuid())

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  fromStageId String?
  fromStage   PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id], onDelete: SetNull)

  toStageId String
  toStage   PipelineStage @relation("ToStage", fields: [toStageId], references: [id], onDelete: Restrict)

  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  note String?

  createdAt DateTime @default(now())

  @@index([dealId])
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
}

enum ActivityStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Activity {
  id String @id @default(cuid())

  title       String
  description String?
  location    String?

  type   ActivityType
  status ActivityStatus @default(PLANNED)

  dueDate     DateTime?
  completedAt DateTime?

  reportSentAt DateTime?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation(fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([assignedToId])
  @@index([leadId])
  @@index([customerId])
  @@index([dealId])
}

model Product {
  id String @id @default(cuid())

  name        String
  code        String  @unique
  description String?

  price Float

  isActive Boolean @default(true)

  quoteItems         QuoteItem[]
  invoiceItems       InvoiceItem[]
  purchaseOrderItems PurchaseOrderItem[]
  pricingGrid        ProductPricing[]
  campaigns          Campaign[]
  recharges          Recharge[]
  offers             Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model ProductPricing {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  country String?
  sector  String?

  unitPrice Decimal @db.Decimal(14, 4)
  unitCost  Decimal @db.Decimal(14, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, country, sector])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id String @id @default(cuid())

  number String  @unique
  title  String
  notes  String?

  subtotal Decimal @db.Decimal(14, 2)
  tax      Decimal @db.Decimal(14, 2)
  discount Decimal @db.Decimal(14, 2)
  total    Decimal @db.Decimal(14, 2)

  validUntil DateTime?
  status     QuoteStatus @default(DRAFT)
  sentAt     DateTime?

  purchaseOrder PurchaseOrder?

  customerId String
  documents  Document[]
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  items QuoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([dealId])
  @@index([status])
}

model QuoteItem {
  id String @id @default(cuid())

  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([quoteId])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  SIGNED
  CANCELLED
}

model PurchaseOrder {
  id String @id @default(cuid())

  number String @unique

  quoteId String? @unique
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  amount        Decimal             @db.Decimal(14, 2)
  paymentMethod String?
  status        PurchaseOrderStatus @default(DRAFT)

  sentAt   DateTime?
  signedAt DateTime?

  signedDocumentPath String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  items    PurchaseOrderItem[]
  contract Contract?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model PurchaseOrderItem {
  id String @id @default(cuid())

  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
}

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  TERMINATED
  EXPIRED
}

model Contract {
  id String @id @default(cuid())

  number      String  @unique
  title       String
  description String?

  amount Decimal @db.Decimal(14, 2)

  startDate DateTime
  endDate   DateTime?
  signedAt  DateTime?
  documents Document[]

  status ContractStatus @default(DRAFT)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  purchaseOrderId String?        @unique
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

model Invoice {
  id String @id @default(cuid())

  number String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  subtotal Decimal @db.Decimal(14, 2)
  discount Decimal @default(0) @db.Decimal(14, 2)
  tax      Decimal @default(0) @db.Decimal(14, 2)
  total    Decimal @db.Decimal(14, 2)

  status InvoiceStatus @default(DRAFT)

  issuedAt DateTime  @default(now())
  dueDate  DateTime?

  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model InvoiceItem {
  id String @id @default(cuid())

  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_MONEY
  WAVE
  ORANGE_MONEY
  MTN_MOMO
  MOOV_MONEY
  CINETPAY
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

model Payment {
  id String @id @default(cuid())

  reference     String  @unique
  transactionId String?

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("XOF")

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  provider         String?
  providerResponse Json?

  paidAt DateTime?

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
  @@index([method])
}

model Recharge {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  amount Decimal  @db.Decimal(14, 2)
  date   DateTime @default(now())

  recordedById String?
  recordedBy   User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([date])
}

enum SenderIdStatus {
  PENDING
  APPROVED
  REJECTED
}

model SenderIdRequest {
  id String @id @default(cuid())

  name    String
  partner String?

  status SenderIdStatus @default(PENDING)
  notes  String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("SenderIdRequestedBy", fields: [requestedById], references: [id])

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

enum CampaignType {
  EMAIL
  SMS
  WHATSAPP
  VOICE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  RUNNING
  FINISHED
  FAILED
  CANCELLED
}

model Campaign {
  id String @id @default(cuid())

  name    String
  subject String?
  message String

  type   CampaignType
  status CampaignStatus @default(DRAFT)

  country String?

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?

  anomalyDetectedAt DateTime?
  anomalyReason     String?

  createdById String?
  createdBy   User?   @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  recipients CampaignRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  REJECTED
}

model CampaignRecipient {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  destination String

  status CampaignRecipientStatus @default(PENDING)

  errorCode String?

  cost Decimal? @db.Decimal(14, 4)

  sentAt      DateTime?
  deliveredAt DateTime?

  providerMessageId String?

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([status])
  @@index([providerMessageId])
}

enum DocumentType {
  CONTRACT
  INVOICE
  QUOTE
  PURCHASE_ORDER
  IMAGE
  PDF
  WORD
  EXCEL
  OTHER
}

model Document {
  id String @id @default(cuid())

  name     String
  fileName String
  path     String
  mimeType String
  size     Int

  type DocumentType @default(OTHER)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  uploadedById String
  uploadedBy   User   @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([uploadedById])
  @@index([dealId])
  @@index([quoteId])
  @@index([contractId])
}

model Objective {
  id String @id @default(cuid())

  userId String
  user   User   @relation("ObjectiveOwner", fields: [userId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  targetAmount Decimal @db.Decimal(14, 2)
  targetDeals  Int?

  createdById String
  createdBy   User   @relation("ObjectiveCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([periodStart, periodEnd])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

model Notification {
  id String @id @default(cuid())

  title   String
  message String

  type    NotificationType    @default(INFO)
  channel NotificationChannel @default(IN_APP)

  isRead Boolean   @default(false)
  sentAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  EXPORT
}

model AuditLog {
  id String @id @default(cuid())

  action AuditAction

  entity      String
  entityId    String?
  description String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([action])
}

model Company {
  id String @id @default(cuid())

  name String @unique
  code String @unique

  email   String?
  phone   String?
  website String?

  address String?
  city    String?
  country String?

  taxNumber String?
  users     User[]
  customers Customer[]
  offers    Offer[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OfferStatus {
  DRAFT
  ACTIVE
  EXPIRED
  DISABLED
}

model Offer {
  id String @id @default(cuid())

  name String
  code String @unique

  description String?

  price Decimal @db.Decimal(14, 2)

  duration Int?

  status OfferStatus @default(DRAFT)

  isActive Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([productId])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

model Subscription {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Restrict)

  startDate DateTime
  endDate   DateTime?

  amount Decimal @db.Decimal(14, 2)

  status SubscriptionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([offerId])
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id String @id @default(cuid())

  reference String @unique

  subject     String
  description String?

  priority TicketPriority @default(MEDIUM)

  status TicketStatus @default(OPEN)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([assignedToId])
  @@index([status])
}

model Warehouse {
  id String @id @default(cuid())

  code String @unique
  name String

  address String?
  city    String?
  country String?

  manager String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
